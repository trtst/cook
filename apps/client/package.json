{
  "name": "@next-meal/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "pnpm --dir ../.. --filter @next-meal/platform build && pnpm --dir ../.. --filter @next-meal/domain build && pnpm --dir ../.. --filter @next-meal/api-client build && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "check": "pnpm lint && pnpm type-check && pnpm build:mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "@next-meal/api-client": "workspace:*",
    "@next-meal/platform": "workspace:*",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "sass": "1.101.0",
    "typescript-eslint": "8.64.0",
    "vite": "5.2.8",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.7"
  }
}
