{
  "name": "@next-meal/api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node scripts/dev-api.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "verify:admin-readonly-flow": "tsx scripts/verify-admin-readonly-flow.ts",
    "verify:admin-user-management-flow": "tsx scripts/verify-admin-user-management-flow.ts",
    "verify:admin-recipe-flow": "tsx scripts/verify-admin-recipe-flow.ts",
    "repair:empty-recipe-collections": "tsx scripts/repair-empty-recipe-collections.ts",
    "verify:dto-flow": "tsx scripts/verify-dto-flow.ts",
    "verify:login-flow": "tsx scripts/verify-login-flow.ts",
    "verify:dining-group-flow": "tsx scripts/verify-dining-group-flow.ts",
    "verify:meal-pantry-flow": "tsx scripts/verify-meal-pantry-flow.ts",
    "verify:meal-poll-flow": "tsx scripts/verify-meal-poll-flow.ts",
    "verify:openapi": "tsx scripts/verify-openapi.ts",
    "verify:recipe-flow": "tsx scripts/verify-recipe-flow.ts",
    "verify:taste-profile-flow": "tsx scripts/verify-taste-profile-flow.ts"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/client": "5.22.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "prisma": "5.22.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
