enum ShoppingStatus {
  OPEN
  BOUGHT
  DELETED
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  VOIDED
}

enum ShoppingListMemberRole {
  OWNER
  COLLABORATOR
}

enum ShoppingListInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum ShoppingSourceType {
  MANUAL
  RECIPE
  PLAN
  EVENT
  BRING
  RANDOM_MENU
}

enum HomeFeatureBoardPlacement {
  MAIN
  SIDE_TOP
  SIDE_BOTTOM
  QUICK_1
  QUICK_2
  QUICK_3
  QUICK_4
}

enum HomeFeatureBoardTargetType {
  PAGE
  WEB_VIEW
}

enum HomeEntryStatus {
  LISTED
  UNLISTED
}

enum HomeTopicType {
  WEEKEND_GATHERING
  QUICK_AFTER_WORK
  HOME_STYLE
  ONE_PERSON
  BREAKFAST
  LIGHT_DINNER
}

enum HomeTopicStatus {
  LISTED
  UNLISTED
}

enum TableTopicStatus {
  LISTED
  UNLISTED
}

enum TableTopicTargetType {
  PAGE
  WEB_VIEW
}

enum StorageLedgerModule {
  RECIPE
  FRIDGE
  MEAL
  SHOPPING
  MEAL_GUEST
  TECHNICAL_SNAPSHOT
  RECYCLE_BIN
  PROFILE_ASSET
}

enum MedalAwardRule {
  MEAL_COMPLETION
  DINING_EVENT_COMPLETION
  GROUP_MEAL_COMPLETION
  FULL_LOOP_COMPLETION
  RECOMMENDATION_ADOPTED_TOTAL
}

enum MedalCategory {
  MEAL_CHECKIN
  DINING_COLLABORATION
  HOLIDAY_LIMITED
  RECOMMENDATION_CONTRIBUTION
}

enum MedalTemplateStatus {
  DRAFT
  LISTED
  UNLISTED
  ARCHIVED
}

enum UploadAssetType {
  RECIPE
}

enum UploadAssetScene {
  RECIPE_COVER
  RECIPE_STEP
}

enum UploadAssetStatus {
  TEMP
  BOUND
  DELETED
}

enum RecipeImportSourceType {
  MARKDOWN
  EXCEL
}

enum RecipeImportJobStatus {
  PENDING
  RUNNING
  READY
  FAILED
  COMPLETED
}

enum RecipeImportItemStatus {
  PENDING_PARSE
  NEEDS_FIX
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

model AdminAccount {
  id           Int                @id @default(autoincrement())
  username     String             @unique @db.VarChar(64)
  displayName  String             @map("display_name") @db.VarChar(64)
  passwordHash String             @map("password_hash") @db.VarChar(255)
  roles        String[]           @default(["SUPER_ADMIN"])
  status       AdminAccountStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyRecordAdmin")
  auditEvents        AuditEvent[]        @relation("AuditEventAdmin")
  recipeImportJobs   RecipeImportJob[]

  @@map("admin_accounts")
}

model HomeFeatureBoardCard {
  placement   HomeFeatureBoardPlacement  @id
  title       String                     @db.VarChar(20)
  subtitle    String?                    @db.VarChar(40)
  status      HomeEntryStatus            @default(LISTED)
  targetType  HomeFeatureBoardTargetType @map("target_type")
  targetValue String                     @map("target_value") @db.VarChar(512)
  artImageUrl String?                    @map("art_image_url") @db.VarChar(512)
  badgeText   String?                    @map("badge_text") @db.VarChar(8)
  version     Int                        @default(1)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("home_feature_board_cards")
}

model HomeTopic {
  id            Int             @id @default(autoincrement())
  title         String          @db.VarChar(20)
  subTitle      String?         @map("sub_title") @db.VarChar(40)
  recType       HomeTopicType   @map("rec_type")
  status        HomeTopicStatus @default(UNLISTED)
  issueNo       Int             @unique @map("issue_no")
  description   String          @db.VarChar(120)
  coverImageUrl String?         @map("cover_image_url") @db.VarChar(512)
  publishedAt   DateTime        @map("published_at") @db.Timestamptz(3)
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items HomeTopicItem[]

  @@index([status, publishedAt, id])
  @@map("home_topics")
}

model HomeTopicItem {
  id              Int      @id @default(autoincrement())
  topicId         Int      @map("topic_id")
  recipeId        Int      @map("recipe_id")
  sourceVersionId Int      @map("source_version_id")
  sortOrder       Int      @map("sort_order")
  recommendNote String? @map("recommend_note") @db.VarChar(60)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic         HomeTopic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  recipe        Recipe               @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  sourceVersion RecipeContentVersion @relation("HomeTopicItemSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Restrict)

  @@unique([topicId, recipeId])
  @@unique([topicId, sortOrder])
  @@index([topicId, sortOrder, id])
  @@index([sourceVersionId])
  @@map("home_topic_items")
}

model TableTopic {
  id            Int                  @id @default(autoincrement())
  title         String               @db.VarChar(30)
  summary       String               @db.VarChar(240)
  status        TableTopicStatus     @default(UNLISTED)
  targetType    TableTopicTargetType @map("target_type")
  targetValue   String?              @map("target_value") @db.VarChar(512)
  coverImageUrl String?              @map("cover_image_url") @db.VarChar(512)
  activityAt    DateTime             @map("activity_at") @db.Timestamptz(3)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants TableTopicParticipant[]

  @@index([status, activityAt, id])
  @@map("table_topics")
}

model TableTopicParticipant {
  id        Int      @id @default(autoincrement())
  topicId   Int      @map("topic_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  topic TableTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId, createdAt])
  @@index([topicId, createdAt, id])
  @@map("table_topic_participants")
}

model User {
  id                   Int        @id @default(autoincrement())
  uid                  Int        @unique
  nickname             String?    @db.VarChar(64)
  avatarUrl            String?    @map("avatar_url") @db.VarChar(512)
  profileBackgroundUrl String?    @map("profile_background_url") @db.VarChar(512)
  homeBackgroundUrl    String?    @map("home_background_url") @db.VarChar(512)
  phone                String?    @unique @db.VarChar(32)
  passwordHash         String?    @map("password_hash") @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  sessionVersion       Int        @default(0) @map("session_version")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedDiningGroup          DiningGroup?               @relation("DiningGroupOwner")
  memberships               DiningGroupMember[]
  createdInvites            DiningGroupInvite[]        @relation("DiningGroupInviteCreator")
  acceptedInvites           DiningGroupInvite[]        @relation("DiningGroupInviteAcceptor")
  entitlementGrant          EntitlementGrant?
  tasteProfile              UserTasteProfile?
  idempotencyRecords        IdempotencyRecord[]        @relation("IdempotencyRecordUser")
  auditEvents               AuditEvent[]               @relation("AuditEventActor")
  recipes                   Recipe[]                   @relation("RecipeOwner")
  recipeCategories          RecipeCategory[]
  recipeScenes              RecipeScene[]
  recipeDrafts              RecipeDraft[]
  recipeVersions            RecipeContentVersion[]     @relation("RecipeContentAuthor")
  recipeReports             RecipeReport[]             @relation("RecipeReportReporter")
  recipeRecommendations    RecipeRecommendation[]
  recipeCollections         RecipeCollection[]
  ingredients               Ingredient[]               @relation("IngredientOwner")
  ingredientRecommendations IngredientRecommendation[]
  ingredientFeedbacks       IngredientFeedback[]
  units                     Unit[]                     @relation("UnitOwner")
  unitRecommendations       UnitRecommendation[]
  mealPlans                 MealPlanItem[]
  mealPolls                 MealPoll[]                @relation("MealPollCreator")
  mealPollSuggestions       MealPollCandidate[]       @relation("MealPollCandidateSuggester")
  mealPollResponses         MealPollResponse[]
  diningEvents              DiningEvent[]              @relation("DiningEventOwner")
  diningEventParticipants   DiningEventParticipant[]   @relation("DiningEventParticipantUser")
  diningEventCookItems      DiningEventMenuItem[]      @relation("DiningEventMenuItemCook")
  diningEventMemoryShares   DiningEventMemoryShare[]   @relation("DiningEventMemoryShareCreator")
  diningGroupActivities     DiningGroupActivity[]      @relation("DiningGroupActivityActor")
  fridgeItems               FridgeItem[]
  shoppingItems             ShoppingItem[]
  shoppingItemFridgeReservations ShoppingItemFridgeReservation[]
  ownedShoppingLists        ShoppingList[]          @relation("ShoppingListOwner")
  shoppingListMembers       ShoppingListMember[]    @relation("ShoppingListMemberUser")
  addedShoppingListMembers  ShoppingListMember[]    @relation("ShoppingListMemberAdder")
  receivedShoppingListInvites ShoppingListInvite[]  @relation("ShoppingListInviteTarget")
  createdShoppingListInvites ShoppingListInvite[]   @relation("ShoppingListInviteCreator")
  acceptedShoppingListInvites ShoppingListInvite[]  @relation("ShoppingListInviteAcceptor")
  createdShoppingShareTokens ShoppingShareToken[]   @relation("ShoppingShareTokenCreator")
  checkedShoppingItems      ShoppingItem[]          @relation("ShoppingItemCheckedBy")
  removedShoppingItems      ShoppingItem[]          @relation("ShoppingItemRemovedBy")
  storageLedger             StorageLedger[]
  tableTopicParticipants    TableTopicParticipant[]
  uploadAssets              UploadAsset[]
  userMedals                UserMedal[]

  @@index([createdAt])
  @@map("users")
}

model UserTasteProfile {
  userId              Int      @id @map("user_id")
  allergies           String[] @default([])
  strictDislikes      String[] @default([]) @map("strict_dislikes")
  dislikedIngredients String[] @default([]) @map("disliked_ingredients")
  flavorPreferences   String[] @default([]) @map("flavor_preferences")
  note                String?  @db.VarChar(1000)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_taste_profiles")
}

model DiningGroup {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(80)
  description      String?           @db.VarChar(120)
  coverStorageKey  String?           @map("cover_storage_key") @db.VarChar(255)
  coverContentType String?           @map("cover_content_type") @db.VarChar(64)
  ownerId          Int               @unique @map("owner_id")
  status           DiningGroupStatus @default(ACTIVE)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User                @relation("DiningGroupOwner", fields: [ownerId], references: [id])
  members            DiningGroupMember[]
  invites            DiningGroupInvite[]
  idempotencyRecords IdempotencyRecord[]
  auditEvents        AuditEvent[]
  mealPolls          MealPoll[]
  activities         DiningGroupActivity[]
  diningEvents       DiningEvent[]
  diningEventMemoryShares DiningEventMemoryShare[]

  @@index([status, createdAt])
  @@index([name])
  @@map("dining_groups")
}

model DiningGroupMember {
  id            Int                         @id @default(autoincrement())
  diningGroupId Int                         @map("dining_group_id")
  userId        Int                         @map("user_id")
  role          DiningGroupRole
  status        LongTermMemberStatus        @default(ACTIVE)
  statusReason  LongTermMemberStatusReason? @map("status_reason")
  joinedAt      DateTime                    @default(now()) @map("joined_at") @db.Timestamptz(3)
  restrictedAt  DateTime?                   @map("restricted_at") @db.Timestamptz(3)
  endedAt       DateTime?                   @map("ended_at") @db.Timestamptz(3)
  version       Int                         @default(1)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([diningGroupId, userId])
  @@index([diningGroupId, status])
  @@index([userId, status])
  @@map("dining_group_members")
}

model DiningGroupInvite {
  id               Int                     @id @default(autoincrement())
  diningGroupId    Int                     @map("dining_group_id")
  createdByUserId  Int                     @map("created_by_user_id")
  acceptedByUserId Int?                    @map("accepted_by_user_id")
  tokenHash        String                  @unique @map("token_hash") @db.VarChar(128)
  status           DiningGroupInviteStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?               @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?               @map("revoked_at") @db.Timestamptz(3)
  policyVersion    Int                     @default(1) @map("policy_version")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  createdBy   User        @relation("DiningGroupInviteCreator", fields: [createdByUserId], references: [id])
  acceptedBy  User?       @relation("DiningGroupInviteAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([diningGroupId, status])
  @@index([tokenHash, status, expiresAt])
  @@index([expiresAt])
  @@map("dining_group_invites")
}

enum EntitlementTier {
  FREE
  PLUS
  PRO
  ULTRA
}

/// Free 由服务端默认解析；这里只保存用户级有效套餐事实。
model EntitlementGrant {
  id        Int             @id @default(autoincrement())
  userId    Int             @unique @map("user_id")
  tier      EntitlementTier
  startsAt  DateTime        @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime?       @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, endsAt])
  @@map("entitlement_grants")
}

model RecipeCategory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(20)
  searchKey String   @map("search_key") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes Recipe[]
  drafts  RecipeDraft[]

  @@unique([userId, searchKey])
  @@unique([userId, sortOrder])
  @@index([userId, sortOrder, id])
  @@map("recipe_categories")
}

model RecipeScene {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(20)
  searchKey String   @map("search_key") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeLinks     RecipeSceneLink[]
  collectionLinks RecipeCollectionScene[]
  draftLinks      RecipeDraftScene[]

  @@unique([userId, searchKey])
  @@unique([userId, sortOrder])
  @@index([userId, sortOrder, id])
  @@map("recipe_scenes")
}

model InspirationCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(20)
  iconKey   String?  @map("icon_key") @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipes               Recipe[]               @relation("RecipeInspirationCategory")
  recipeRecommendations RecipeRecommendation[] @relation("RecipeRecommendationCategory")

  @@unique([name])
  @@unique([sortOrder])
  @@index([sortOrder, id])
  @@map("inspiration_categories")
}

model IngredientCategory {
  id           Int      @id @default(autoincrement())
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(20)
  iconKey      String?  @map("icon_key") @db.VarChar(64)
  isSelectable Boolean  @default(true) @map("is_selectable")
  sortOrder    Int      @default(0) @map("sort_order")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredients         Ingredient[]
  feedbacks           IngredientFeedback[] @relation("IngredientFeedbackCategory")
  suggestedFeedbacks  IngredientFeedback[] @relation("IngredientFeedbackSuggestedCategory")

  @@unique([code])
  @@unique([name])
  @@unique([sortOrder])
  @@index([sortOrder, id])
  @@map("ingredient_categories")
}

model Unit {
  id              Int      @id @default(autoincrement())
  ownerId         Int?     @map("owner_id")
  type            UnitType
  name            String   @db.VarChar(16)
  searchKey       String   @map("search_key") @db.VarChar(32)
  systemSortOrder Int?     @map("system_sort_order")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User?        @relation("UnitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  defaultIngredients Ingredient[] @relation("IngredientDefaultUnit")
  fridgeItems        FridgeItem[] @relation("FridgeItemExactUnit")
  shoppingItemFridgeReservations ShoppingItemFridgeReservation[] @relation("ShoppingItemFridgeReservationUnit")
  targetRecommendations UnitRecommendation[] @relation("UnitRecommendationTarget")

  /// PostgreSQL partial unique indexes for system/personal unit names are kept in hand-written SQL migrations.
  @@index([ownerId, type, searchKey, id])
  @@index([ownerId, type, systemSortOrder, id])
  @@map("units")
}

model UnitRecommendation {
  id           Int                      @id @default(autoincrement())
  userId       Int                      @map("user_id")
  unitName     String                   @map("unit_name") @db.VarChar(16)
  unitType     UnitType                 @map("unit_type")
  searchKey    String                   @map("search_key") @db.VarChar(32)
  status       UnitRecommendationStatus @default(PENDING)
  reviewNote   String?                  @map("review_note") @db.VarChar(255)
