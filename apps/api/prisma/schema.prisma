enum RecipeProteinType {
  PORK
  CHICKEN
  BEEF
  LAMB
  DUCK
  FISH
  NONE
}

enum IngredientProteinType {
  PORK
  CHICKEN
  BEEF
  LAMB
  DUCK
  SEAFOOD
  EGG
  TOFU
  NONE
}

enum RecipeVersionTagCode {
  DISH_ROLE
  MEAL_TYPE
  MAIN_PROTEIN_TYPE
  PRIMARY_INGREDIENT
  FLAVOR_PROFILE
  SPICE_LEVEL
}

enum RecipeVersionTagSource {
  AUTO
  USER
  OPS
  AI
}

enum RecipeReportStatus {
  OPEN
  RESOLVED
}

enum RecipeRecommendationStatus {
  PENDING
  REJECTED
  ADOPTED
  WITHDRAWN
}

enum UnitType {
  WEIGHT
  VOLUME
  COMMON
  PACKAGE
}

enum IngredientStatus {
  ACTIVE
  DISABLED
  MERGED
}

enum IngredientRecommendationStatus {
  PENDING
  REJECTED
  ADOPTED
  MERGED
}

enum IngredientFeedbackStatus {
  PENDING
  REJECTED
  ADOPTED
}

enum UnitRecommendationStatus {
  PENDING
  REJECTED
  ADOPTED
  MERGED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  AFTERNOON_TEA
  DINNER
  LATE_NIGHT
}

enum MealPlanStatus {
  PLANNED
  COMPLETED
}

enum MealPlanDishPurchaseState {
  READY
  PENDING
}

enum DiningEventStatus {
  PLANNED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DiningEventParticipantSource {
  DINING_GROUP
  SHARE
}

enum DiningEventParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum MealPollStatus {
  OPEN
  CLOSED
  CONFIRMED
  COMPLETED
}

enum MealPollCandidateSourceType {
  RECIPE
  SUGGESTION
}

enum MealPollCandidateStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum ActivityState {
  PENDING
  DONE
  EXPIRED
}

enum DiningGroupActivityKind {
  POLL_OPENED
  POLL_VOTED
  POLL_SUGGESTED
  POLL_NOTED
  MENU_CONFIRMED
  COOK_CLAIMED
  BRING_UPDATED
  MEAL_COMPLETED
