generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DiningGroupStatus {
  ACTIVE
  ARCHIVED
}

enum DiningGroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum LongTermMemberStatus {
  ACTIVE
  RESTRICTED
  ENDED
}

enum LongTermMemberStatusReason {
  LEFT
  REMOVED
  USER_OVER_LIMIT
  OWNER_OVER_LIMIT
  GROUP_DISSOLVED
}

enum DiningGroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RecipeStatus {
  ACTIVE
  RECYCLED
  BLOCKED
  DELETED
}

enum RecipeDifficulty {
  BEGINNER
  EASY
  SKILLED
  CHALLENGING
}

enum RecipeDuration {
  WITHIN_15
  BETWEEN_15_30
  BETWEEN_30_60
  OVER_60
}

enum RecipeSlotType {
  MEAT
  VEGETABLE
  SOUP
  STAPLE
  BREAKFAST_STAPLE
  BREAKFAST_PROTEIN
  BREAKFAST_SIDE
