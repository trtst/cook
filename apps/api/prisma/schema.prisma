generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DiningGroupStatus {
  ACTIVE
  ARCHIVED
}

enum DiningGroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum LongTermMemberStatus {
  ACTIVE
  RESTRICTED
  ENDED
}

enum LongTermMemberStatusReason {
  LEFT
  REMOVED
  USER_OVER_LIMIT
  OWNER_OVER_LIMIT
  GROUP_DISSOLVED
}

enum DiningGroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RecipeStatus {
  ACTIVE
  RECYCLED
  BLOCKED
  DELETED
}

enum RecipeDifficulty {
  BEGINNER
  EASY
  SKILLED
  CHALLENGING
}

enum RecipeDuration {
  WITHIN_15
  BETWEEN_15_30
  BETWEEN_30_60
  OVER_60
}

enum RecipeReportStatus {
  OPEN
  RESOLVED
}

enum RecipeRecommendationStatus {
  PENDING
  REJECTED
  ADOPTED
  WITHDRAWN
}

enum UnitType {
  WEIGHT
  VOLUME
  COUNT
  SHAPE
  CONTAINER
  PACKAGE
  OTHER
}

enum IngredientStatus {
  ACTIVE
  DISABLED
  MERGED
}

enum IngredientRecommendationStatus {
  PENDING
  REJECTED
  ADOPTED
  MERGED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum DiningEventStatus {
  PLANNED
  CONFIRMED
  CANCELLED
}

enum DiningEventParticipantSource {
  DINING_GROUP
  SHARE
}

enum DiningEventParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum ShoppingStatus {
  OPEN
  BOUGHT
  DELETED
}

enum ShoppingSourceType {
  MANUAL
  PLAN
  EVENT
  BRING
}

enum StorageLedgerModule {
  RECIPE
  FRIDGE
  MEAL
  SHOPPING
  MEAL_GUEST
  TECHNICAL_SNAPSHOT
  RECYCLE_BIN
  PROFILE_ASSET
}

enum UploadAssetType {
  RECIPE
}

enum UploadAssetScene {
  RECIPE_COVER
  RECIPE_STEP
}

enum UploadAssetStatus {
  TEMP
  BOUND
  DELETED
}

model AdminAccount {
  id           Int                @id @default(autoincrement())
  username     String             @unique @db.VarChar(64)
  displayName  String             @map("display_name") @db.VarChar(64)
  passwordHash String             @map("password_hash") @db.VarChar(255)
  roles        String[]           @default(["SUPER_ADMIN"])
  status       AdminAccountStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyRecordAdmin")
  auditEvents        AuditEvent[]        @relation("AuditEventAdmin")

  @@map("admin_accounts")
}

model User {
  id                   Int        @id @default(autoincrement())
  uid                  Int        @unique
  nickname             String?    @db.VarChar(64)
  avatarUrl            String?    @map("avatar_url") @db.VarChar(512)
  profileBackgroundUrl String?    @map("profile_background_url") @db.VarChar(512)
  homeBackgroundUrl    String?    @map("home_background_url") @db.VarChar(512)
  phone                String?    @unique @db.VarChar(32)
  passwordHash         String?    @map("password_hash") @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  sessionVersion       Int        @default(0) @map("session_version")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedDiningGroup          DiningGroup?               @relation("DiningGroupOwner")
  memberships               DiningGroupMember[]
  createdInvites            DiningGroupInvite[]        @relation("DiningGroupInviteCreator")
  acceptedInvites           DiningGroupInvite[]        @relation("DiningGroupInviteAcceptor")
  entitlementGrant          EntitlementGrant?
  tasteProfile              UserTasteProfile?
  idempotencyRecords        IdempotencyRecord[]        @relation("IdempotencyRecordUser")
  auditEvents               AuditEvent[]               @relation("AuditEventActor")
  recipes                   Recipe[]                   @relation("RecipeOwner")
  recipeCategories          RecipeCategory[]
  recipeScenes              RecipeScene[]
  recipeDrafts              RecipeDraft[]
  recipeVersions            RecipeContentVersion[]     @relation("RecipeContentAuthor")
  recipeReports             RecipeReport[]             @relation("RecipeReportReporter")
  recipeRecommendations    RecipeRecommendation[]
  recipeCollections         RecipeCollection[]
  ingredients               Ingredient[]               @relation("IngredientOwner")
  ingredientRecommendations IngredientRecommendation[]
  units                     Unit[]                     @relation("UnitOwner")
  mealPlans                 MealPlanItem[]
  diningEvents              DiningEvent[]              @relation("DiningEventOwner")
  diningEventParticipants   DiningEventParticipant[]   @relation("DiningEventParticipantUser")
  fridgeItems               FridgeItem[]
  shoppingItems             ShoppingItem[]
  storageLedger             StorageLedger[]
  uploadAssets              UploadAsset[]

  @@index([createdAt])
  @@map("users")
}

model UserTasteProfile {
  userId              Int      @id @map("user_id")
  allergies           String[] @default([])
  strictDislikes      String[] @default([]) @map("strict_dislikes")
  dislikedIngredients String[] @default([]) @map("disliked_ingredients")
  flavorPreferences   String[] @default([]) @map("flavor_preferences")
  note                String?  @db.VarChar(1000)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_taste_profiles")
}

model DiningGroup {
  id         Int               @id @default(autoincrement())
  name       String            @db.VarChar(80)
  ownerId    Int               @unique @map("owner_id")
  status     DiningGroupStatus @default(ACTIVE)
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(3)
  version    Int               @default(1)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User                @relation("DiningGroupOwner", fields: [ownerId], references: [id])
  members            DiningGroupMember[]
  invites            DiningGroupInvite[]
  idempotencyRecords IdempotencyRecord[]
  auditEvents        AuditEvent[]
  diningEvents       DiningEvent[]

  @@index([status, createdAt])
  @@index([name])
  @@map("dining_groups")
}

model DiningGroupMember {
  id            Int                         @id @default(autoincrement())
  diningGroupId Int                         @map("dining_group_id")
  userId        Int                         @map("user_id")
  role          DiningGroupRole
  status        LongTermMemberStatus        @default(ACTIVE)
  statusReason  LongTermMemberStatusReason? @map("status_reason")
  joinedAt      DateTime                    @default(now()) @map("joined_at") @db.Timestamptz(3)
  restrictedAt  DateTime?                   @map("restricted_at") @db.Timestamptz(3)
  endedAt       DateTime?                   @map("ended_at") @db.Timestamptz(3)
  version       Int                         @default(1)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([diningGroupId, userId])
  @@index([diningGroupId, status])
  @@index([userId, status])
  @@map("dining_group_members")
}

model DiningGroupInvite {
  id               Int                     @id @default(autoincrement())
  diningGroupId    Int                     @map("dining_group_id")
  createdByUserId  Int                     @map("created_by_user_id")
  acceptedByUserId Int?                    @map("accepted_by_user_id")
  tokenHash        String                  @unique @map("token_hash") @db.VarChar(128)
  status           DiningGroupInviteStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?               @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?               @map("revoked_at") @db.Timestamptz(3)
  policyVersion    Int                     @default(1) @map("policy_version")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  createdBy   User        @relation("DiningGroupInviteCreator", fields: [createdByUserId], references: [id])
  acceptedBy  User?       @relation("DiningGroupInviteAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([diningGroupId, status])
  @@index([tokenHash, status, expiresAt])
  @@index([expiresAt])
  @@map("dining_group_invites")
}

enum EntitlementTier {
  FREE
  PLUS
  PRO
  ULTRA
}

/// Free 由服务端默认解析；这里只保存用户级有效套餐事实。
model EntitlementGrant {
  id        Int             @id @default(autoincrement())
  userId    Int             @unique @map("user_id")
  tier      EntitlementTier
  startsAt  DateTime        @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime?       @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier, endsAt])
  @@map("entitlement_grants")
}

model RecipeCategory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(20)
  searchKey String   @map("search_key") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes Recipe[]
  drafts  RecipeDraft[]

  @@unique([userId, searchKey])
  @@unique([userId, sortOrder])
  @@index([userId, sortOrder, id])
  @@map("recipe_categories")
}

model RecipeScene {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(20)
  searchKey String   @map("search_key") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeLinks     RecipeSceneLink[]
  collectionLinks RecipeCollectionScene[]
  draftLinks      RecipeDraftScene[]

  @@unique([userId, searchKey])
  @@unique([userId, sortOrder])
  @@index([userId, sortOrder, id])
  @@map("recipe_scenes")
}

model InspirationCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(20)
  iconKey   String?  @map("icon_key") @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipes               Recipe[]               @relation("RecipeInspirationCategory")
  recipeRecommendations RecipeRecommendation[] @relation("RecipeRecommendationCategory")

  @@unique([name])
  @@unique([sortOrder])
  @@index([sortOrder, id])
  @@map("inspiration_categories")
}

model IngredientCategory {
  id           Int      @id @default(autoincrement())
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(20)
  iconKey      String?  @map("icon_key") @db.VarChar(64)
  isSelectable Boolean  @default(true) @map("is_selectable")
  sortOrder    Int      @default(0) @map("sort_order")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredients Ingredient[]

  @@unique([code])
  @@unique([name])
  @@unique([sortOrder])
  @@index([sortOrder, id])
  @@map("ingredient_categories")
}

model Unit {
  id              Int      @id @default(autoincrement())
  ownerId         Int?     @map("owner_id")
  type            UnitType
  name            String   @db.VarChar(16)
  searchKey       String   @map("search_key") @db.VarChar(32)
  systemSortOrder Int?     @map("system_sort_order")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User?        @relation("UnitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  defaultIngredients Ingredient[] @relation("IngredientDefaultUnit")

  /// PostgreSQL partial unique indexes for system/personal unit names are kept in hand-written SQL migrations.
  @@index([ownerId, type, searchKey, id])
  @@index([ownerId, type, systemSortOrder, id])
  @@map("units")
}

model Ingredient {
  id              Int              @id @default(autoincrement())
  ownerId         Int?             @map("owner_id")
  categoryId      Int              @map("category_id")
  defaultUnitId   Int              @map("default_unit_id")
  mergedToId      Int?             @map("merged_to_id")
  name            String           @db.VarChar(64)
  searchKey       String           @map("search_key") @db.VarChar(80)
  status          IngredientStatus @default(ACTIVE)
  systemSortOrder Int?             @map("system_sort_order")
  displaySortOrder Int?            @map("display_sort_order")
  imageUpdatedAt  DateTime?        @map("image_updated_at") @db.Timestamptz(3)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                 User?                      @relation("IngredientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category              IngredientCategory         @relation(fields: [categoryId], references: [id])
  defaultUnit           Unit                       @relation("IngredientDefaultUnit", fields: [defaultUnitId], references: [id])
  mergedTo              Ingredient?                @relation("IngredientMergedTo", fields: [mergedToId], references: [id], onDelete: SetNull)
  mergedFrom            Ingredient[]               @relation("IngredientMergedTo")
  recommendations       IngredientRecommendation[] @relation("IngredientRecommendationSource")
  targetRecommendations IngredientRecommendation[] @relation("IngredientRecommendationTarget")

  /// PostgreSQL partial unique indexes for active system/category sort order, global display order, and ingredient name scope are kept in hand-written SQL migrations.
  @@index([ownerId, status, categoryId, systemSortOrder, id])
  @@index([ownerId, status, displaySortOrder, id])
  @@index([ownerId, status, categoryId, searchKey, id])
  @@map("ingredients")
}

model IngredientRecommendation {
  id                 Int                            @id @default(autoincrement())
  ingredientId       Int                            @map("ingredient_id")
  userId             Int                            @map("user_id")
  status             IngredientRecommendationStatus @default(PENDING)
  ingredientName     String                         @map("ingredient_name") @db.VarChar(64)
  categoryId         Int                            @map("category_id")
  categoryName       String                         @map("category_name") @db.VarChar(20)
  defaultUnitId      Int                            @map("default_unit_id")
  defaultUnitName    String                         @map("default_unit_name") @db.VarChar(16)
  reviewNote         String?                        @map("review_note") @db.VarChar(255)
  reviewReasonCode   String?                        @map("review_reason_code") @db.VarChar(32)
  reviewAdvice       String?                        @map("review_advice") @db.VarChar(255)
  targetIngredientId Int?                           @map("target_ingredient_id")
  reviewedAt         DateTime?                      @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredient       Ingredient  @relation("IngredientRecommendationSource", fields: [ingredientId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetIngredient Ingredient? @relation("IngredientRecommendationTarget", fields: [targetIngredientId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([status, createdAt])
  @@map("ingredient_recommendations")
}

model RecipeContentVersion {
  id               Int               @id @default(autoincrement())
  createdByUserId  Int?              @map("created_by_user_id")
  name             String            @db.VarChar(120)
  story            String?           @db.VarChar(2000)
  baseServings     Int               @map("base_servings")
  difficulty       RecipeDifficulty?
  duration         RecipeDuration?
  tips             String?           @db.VarChar(1000)
  ingredientsJson  Json              @map("ingredients_json")
  stepsJson        Json              @map("steps_json")
  imagesJson       Json              @map("images_json")
  searchText       String            @map("search_text") @db.Text
  contentSizeBytes Int               @default(0) @map("content_size_bytes")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  createdByUser           User?                    @relation("RecipeContentAuthor", fields: [createdByUserId], references: [id])
  recommendations         RecipeRecommendation[]   @relation("RecipeRecommendationVersion")
  originRecipes           Recipe[]                 @relation("RecipeOriginVersion")
  currentRecipes          Recipe[]                 @relation("RecipeCurrentVersion")
  collections             RecipeCollection[]       @relation("RecipeCollectionVersion")
  mealPlans               MealPlanItem[]           @relation("MealPlanRecipeVersion")
  diningEventParticipants DiningEventParticipant[] @relation("DiningEventBringVersion")
  uploadAssets            UploadAsset[]

  @@index([name])
  @@index([createdByUserId, createdAt])
  @@map("recipe_content_versions")
}

model Recipe {
  id                    Int          @id @default(autoincrement())
  ownerId               Int?         @map("owner_id")
  categoryId            Int?         @map("category_id")
  inspirationCategoryId Int?         @map("inspiration_category_id")
  currentVersionId      Int          @map("current_version_id")
  originVersionId       Int?         @map("origin_version_id")
  originCoverImageUrl   String?      @map("origin_cover_image_url") @db.VarChar(512)
  title                 String       @db.VarChar(120)
  searchText            String       @map("search_text") @db.Text
  coverImageUrl         String?      @map("cover_image_url") @db.VarChar(512)
  curatedByName         String?      @map("curated_by_name") @db.VarChar(64)
  status                RecipeStatus @default(ACTIVE)
  blockedReason         String?      @map("blocked_reason") @db.VarChar(255)
  blockedAt             DateTime?    @map("blocked_at") @db.Timestamptz(3)
  recycledUntil         DateTime?    @map("recycled_until") @db.Timestamptz(3)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(3)
  reportCount           Int          @default(0) @map("report_count")
  likeCount             Int          @default(0) @map("like_count")
  collectCount          Int          @default(0) @map("collect_count")
  sortOrder             Int          @default(0) @map("sort_order")
  version               Int          @default(1)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                   User?                    @relation("RecipeOwner", fields: [ownerId], references: [id])
  category                RecipeCategory?          @relation(fields: [categoryId], references: [id])
  inspirationCategory     InspirationCategory?     @relation("RecipeInspirationCategory", fields: [inspirationCategoryId], references: [id])
  currentVersion          RecipeContentVersion     @relation("RecipeCurrentVersion", fields: [currentVersionId], references: [id])
  originVersion           RecipeContentVersion?    @relation("RecipeOriginVersion", fields: [originVersionId], references: [id], onDelete: SetNull)
  reports                 RecipeReport[]
  recommendations         RecipeRecommendation[]   @relation("RecipeRecommendationSource")
  adoptedRecommendations  RecipeRecommendation[]   @relation("RecipeRecommendationAdopted")
  sceneLinks              RecipeSceneLink[]
  collections             RecipeCollection[]       @relation("RecipeCollectionSource")
  draft                   RecipeDraft?
  mealPlans               MealPlanItem[]
  diningEventParticipants DiningEventParticipant[] @relation("DiningEventBringRecipe")

  @@index([ownerId, status, categoryId, sortOrder, id])
  @@index([inspirationCategoryId, status, updatedAt, id])
  @@index([ownerId, status, updatedAt])
  @@index([ownerId, originVersionId])
  @@map("recipes")
}

model RecipeSceneLink {
  recipeId  Int      @map("recipe_id")
  sceneId   Int      @map("scene_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recipe Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  scene  RecipeScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([recipeId, sceneId])
  @@index([sceneId, recipeId])
  @@map("recipe_scene_links")
}

model RecipeCollection {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  sourceRecipeId  Int      @map("source_recipe_id")
  sourceVersionId Int      @map("source_version_id")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRecipe  Recipe                  @relation("RecipeCollectionSource", fields: [sourceRecipeId], references: [id])
  sourceVersion RecipeContentVersion    @relation("RecipeCollectionVersion", fields: [sourceVersionId], references: [id])
  sceneLinks    RecipeCollectionScene[]

  @@unique([userId, sourceRecipeId, sourceVersionId])
  @@index([userId, updatedAt, id])
  @@index([sourceRecipeId, userId, id])
  @@map("recipe_collections")
}

model RecipeCollectionScene {
  collectionId Int      @map("collection_id")
  sceneId      Int      @map("scene_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  collection RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  scene      RecipeScene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([collectionId, sceneId])
  @@index([sceneId, collectionId])
  @@map("recipe_collection_scenes")
}

model RecipeDraft {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  recipeId         Int?     @unique @map("recipe_id")
  categoryId       Int?     @map("category_id")
  title            String?  @db.VarChar(120)
  searchText       String   @map("search_text") @db.Text
  contentJson      Json     @map("content_json")
  contentSizeBytes Int      @default(0) @map("content_size_bytes")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe?            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category RecipeCategory?    @relation(fields: [categoryId], references: [id])
  scenes   RecipeDraftScene[]
  uploads  UploadAsset[]

  @@index([userId, updatedAt, id])
  @@map("recipe_drafts")
}

model UploadAsset {
  id              Int               @id @default(autoincrement())
  publicId        String            @unique @map("public_id") @db.VarChar(36)
  userId          Int               @map("user_id")
  draftId         Int?              @map("draft_id")
  recipeVersionId Int?              @map("recipe_version_id")
  type            UploadAssetType
  scene           UploadAssetScene
  slotKey         String            @map("slot_key") @db.VarChar(64)
  storageKey      String            @map("storage_key") @db.VarChar(512)
  contentType     String            @map("content_type") @db.VarChar(64)
  sizeBytes       Int               @map("size_bytes")
  width           Int
  height          Int
  sourceHash      String            @map("source_hash") @db.VarChar(64)
  status          UploadAssetStatus @default(TEMP)
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft         RecipeDraft?          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  recipeVersion RecipeContentVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)

  @@unique([draftId, scene, slotKey])
  @@index([userId, status, updatedAt])
  @@index([draftId, status, updatedAt])
  @@index([recipeVersionId])
  @@map("upload_assets")
}

model RecipeDraftScene {
  draftId   Int      @map("draft_id")
  sceneId   Int      @map("scene_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  draft RecipeDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  scene RecipeScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([draftId, sceneId])
  @@index([sceneId, draftId])
  @@map("recipe_draft_scenes")
}

model RecipeReport {
  id             Int                @id @default(autoincrement())
  recipeId       Int                @map("recipe_id")
  reporterId     Int                @map("reporter_id")
  reason         String             @db.VarChar(255)
  status         RecipeReportStatus @default(OPEN)
  resolutionNote String?            @map("resolution_note") @db.VarChar(255)
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reporter User   @relation("RecipeReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([recipeId, status])
  @@map("recipe_reports")
}

model RecipeRecommendation {
  id                  Int                       @id @default(autoincrement())
  recipeId            Int                       @map("recipe_id")
  userId              Int                       @map("user_id")
  sourceVersionId     Int                       @map("source_version_id")
  suggestedCategoryId Int                       @map("suggested_category_id")
  status              RecipeRecommendationStatus @default(PENDING)
  recipeTitle         String                    @map("recipe_title") @db.VarChar(120)
  curatedByName       String                    @map("curated_by_name") @db.VarChar(64)
  suggestedCategoryName String                  @map("suggested_category_name") @db.VarChar(20)
  reviewNote          String?                   @map("review_note") @db.VarChar(255)
  adoptedRecipeId     Int?                      @unique @map("adopted_recipe_id")
  reviewedAt          DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  withdrawnAt         DateTime?                 @map("withdrawn_at") @db.Timestamptz(3)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipe             Recipe                @relation("RecipeRecommendationSource", fields: [recipeId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVersion      RecipeContentVersion  @relation("RecipeRecommendationVersion", fields: [sourceVersionId], references: [id], onDelete: Cascade)
  suggestedCategory  InspirationCategory   @relation("RecipeRecommendationCategory", fields: [suggestedCategoryId], references: [id])
  adoptedRecipe      Recipe?               @relation("RecipeRecommendationAdopted", fields: [adoptedRecipeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([recipeId, createdAt])
  @@index([status, createdAt])
  @@index([suggestedCategoryId, createdAt])
  @@map("recipe_recommendations")
}

model MealPlanItem {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  planDate        DateTime @map("plan_date") @db.Date
  mealSlot        MealSlot @map("meal_slot")
  recipeId        Int?     @map("recipe_id")
  recipeVersionId Int      @map("recipe_version_id")
  menuSnapshot    Json     @map("menu_snapshot")
  note            String?  @db.VarChar(255)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe        Recipe?              @relation(fields: [recipeId], references: [id])
  recipeVersion RecipeContentVersion @relation("MealPlanRecipeVersion", fields: [recipeVersionId], references: [id])
  diningEvent   DiningEvent?

  @@unique([userId, planDate, mealSlot])
  @@index([userId, planDate])
  @@map("meal_plan_items")
}

model DiningEvent {
  id                  Int               @id @default(autoincrement())
  userId              Int               @map("user_id")
  mealPlanItemId      Int?              @unique @map("meal_plan_item_id")
  diningGroupId       Int?              @map("dining_group_id")
  title               String            @db.VarChar(120)
  scheduledAt         DateTime          @map("scheduled_at") @db.Timestamptz(3)
  location            String?           @db.VarChar(255)
  status              DiningEventStatus @default(PLANNED)
  menuSnapshot        Json              @map("menu_snapshot")
  shareTokenHash      String?           @unique @map("share_token_hash") @db.VarChar(128)
  shareTokenExpiresAt DateTime?         @map("share_token_expires_at") @db.Timestamptz(3)
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                     @relation("DiningEventOwner", fields: [userId], references: [id], onDelete: Cascade)
  mealPlanItem MealPlanItem?            @relation(fields: [mealPlanItemId], references: [id])
  diningGroup  DiningGroup?             @relation(fields: [diningGroupId], references: [id])
  participants DiningEventParticipant[]

  @@index([userId, scheduledAt])
  @@index([diningGroupId, scheduledAt])
  @@map("dining_events")
}

model DiningEventParticipant {
  id             Int                          @id @default(autoincrement())
  diningEventId  Int                          @map("dining_event_id")
  userId         Int?                         @map("user_id")
  guestName      String?                      @map("guest_name") @db.VarChar(120)
  sourceType     DiningEventParticipantSource @map("source_type")
  status         DiningEventParticipantStatus @default(INVITED)
  bringRecipeId  Int?                         @map("bring_recipe_id")
  bringVersionId Int?                         @map("bring_version_id")
  respondedAt    DateTime?                    @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningEvent  DiningEvent           @relation(fields: [diningEventId], references: [id], onDelete: Cascade)
  user         User?                 @relation("DiningEventParticipantUser", fields: [userId], references: [id])
  bringRecipe  Recipe?               @relation("DiningEventBringRecipe", fields: [bringRecipeId], references: [id])
  bringVersion RecipeContentVersion? @relation("DiningEventBringVersion", fields: [bringVersionId], references: [id])

  @@index([diningEventId, status])
  @@index([userId, status])
  @@map("dining_event_participants")
}

model FridgeItem {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  name         String    @db.VarChar(120)
  quantityText String?   @map("quantity_text") @db.VarChar(64)
  note         String?   @db.VarChar(255)
  available    Boolean   @default(true)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, available, updatedAt])
  @@index([userId, name])
  @@map("fridge_items")
}

model ShoppingItem {
  id           Int                @id @default(autoincrement())
  userId       Int                @map("user_id")
  name         String             @db.VarChar(120)
  quantityText String?            @map("quantity_text") @db.VarChar(64)
  note         String?            @db.VarChar(255)
  sourceType   ShoppingSourceType @map("source_type")
  sourceKey    String?            @map("source_key") @db.VarChar(120)
  status       ShoppingStatus     @default(OPEN)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([userId, sourceType, sourceKey])
  @@map("shopping_items")
}

model StorageLedger {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  module    StorageLedgerModule
  recordKey String              @map("record_key") @db.VarChar(160)
  usedBytes Int                 @map("used_bytes")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, recordKey])
  @@index([userId, module])
  @@map("storage_ledger")
}

model IdempotencyRecord {
  id            Int               @id @default(autoincrement())
  operationId   String            @map("operation_id") @db.VarChar(64)
  operationType String            @map("operation_type") @db.VarChar(64)
  userId        Int?              @map("user_id")
  adminId       Int?              @map("admin_id")
  diningGroupId Int?              @map("dining_group_id")
  requestHash   String            @map("request_hash") @db.VarChar(64)
  status        IdempotencyStatus @default(PROCESSING)
  resultJson    Json?             @map("result_json")
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?         @relation("IdempotencyRecordUser", fields: [userId], references: [id], onDelete: Restrict)
  admin       AdminAccount? @relation("IdempotencyRecordAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  diningGroup DiningGroup?  @relation(fields: [diningGroupId], references: [id])

  @@index([userId, operationType])
  @@index([adminId, operationType])
  @@index([diningGroupId, operationType])
  @@index([operationId, operationType, userId, diningGroupId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id            Int            @id @default(autoincrement())
  actorType     AuditActorType @map("actor_type")
  actorUserId   Int?           @map("actor_user_id")
  actorAdminId  Int?           @map("actor_admin_id")
  action        String         @db.VarChar(64)
  objectType    String         @map("object_type") @db.VarChar(64)
  objectId      Int?           @map("object_id")
  diningGroupId Int?           @map("dining_group_id")
  payload       Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser   User?         @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorAdmin  AdminAccount? @relation("AuditEventAdmin", fields: [actorAdminId], references: [id], onDelete: Restrict)
  diningGroup DiningGroup?  @relation(fields: [diningGroupId], references: [id])

  @@index([actorType, actorUserId, createdAt])
  @@index([actorType, actorAdminId, createdAt])
  @@index([objectType, objectId])
  @@index([diningGroupId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            Int          @id @default(autoincrement())
  eventType     String       @map("event_type") @db.VarChar(64)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   Int          @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  nextRunAt     DateTime     @default(now()) @map("next_run_at") @db.Timestamptz(3)
  doneAt        DateTime?    @map("done_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextRunAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
