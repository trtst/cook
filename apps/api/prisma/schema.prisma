generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DiningGroupStatus {
  ACTIVE
  FROZEN
  ARCHIVED
}

enum DiningGroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum LongTermMemberStatus {
  ACTIVE
  RESTRICTED
  ENDED
}

enum LongTermMemberStatusReason {
  LEFT
  REMOVED
  GROUP_DOWNGRADED
  GROUP_DISSOLVED
}

enum DiningGroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum CarryBackSnapshotStatus {
  AVAILABLE
  EXPIRED
  DELETED
  INVALIDATED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model AdminAccount {
  id           String             @id @default(uuid()) @db.Uuid
  username     String             @unique @db.VarChar(64)
  displayName  String             @map("display_name") @db.VarChar(64)
  passwordHash String             @map("password_hash") @db.VarChar(255)
  roles        String[]           @default(["SUPER_ADMIN"])
  status       AdminAccountStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_accounts")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  uid          Int        @unique
  nickname     String?    @db.VarChar(64)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(512)
  phone        String?    @unique @db.VarChar(32)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedDiningGroup   DiningGroup?        @relation("DiningGroupOwner")
  space              UserSpace?          @relation("UserSpaceUser")
  memberships        DiningGroupMember[]
  createdInvites     DiningGroupInvite[] @relation("DiningGroupInviteCreator")
  acceptedInvites    DiningGroupInvite[] @relation("DiningGroupInviteAcceptor")
  carryBackSnapshots CarryBackSnapshot[]
  entitlementGrant   EntitlementGrant?
  tasteProfile       UserTasteProfile?
  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyRecordUser")
  auditEvents        AuditEvent[]        @relation("AuditEventActor")

  @@index([createdAt])
  @@map("users")
}

model UserTasteProfile {
  userId               String   @id @map("user_id") @db.Uuid
  allergies            String[] @default([])
  strictDislikes       String[] @default([]) @map("strict_dislikes")
  dislikedIngredients String[] @default([]) @map("disliked_ingredients")
  flavorPreferences   String[] @default([]) @map("flavor_preferences")
  note                String?  @db.VarChar(1000)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_taste_profiles")
}

model DiningGroup {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @db.VarChar(80)
  ownerId    String            @unique @map("owner_id") @db.Uuid
  status     DiningGroupStatus @default(ACTIVE)
  frozenAt   DateTime?         @map("frozen_at") @db.Timestamptz(3)
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(3)
  version    Int               @default(1)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                  User                 @relation("DiningGroupOwner", fields: [ownerId], references: [id])
  members                DiningGroupMember[]
  invites                DiningGroupInvite[]
  originalSpaces         UserSpace[]          @relation("OriginalDiningGroup")
  currentSpaces          UserSpace[]          @relation("CurrentDiningGroup")
  sourceSnapshots        CarryBackSnapshot[]  @relation("CarryBackSource")
  targetSnapshots        CarryBackSnapshot[]  @relation("CarryBackTarget")
  idempotencyRecords     IdempotencyRecord[]
  auditEvents            AuditEvent[]
  entitlementGrant       EntitlementGrant?

  @@index([status, createdAt])
  @@index([name])
  @@map("dining_groups")
}

model UserSpace {
  userId                   String   @id @map("user_id") @db.Uuid
  originalDiningGroupId    String   @unique @map("original_dining_group_id") @db.Uuid
  currentDiningGroupId     String   @map("current_dining_group_id") @db.Uuid
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User        @relation("UserSpaceUser", fields: [userId], references: [id])
  originalDiningGroup DiningGroup @relation("OriginalDiningGroup", fields: [originalDiningGroupId], references: [id])
  currentDiningGroup  DiningGroup @relation("CurrentDiningGroup", fields: [currentDiningGroupId], references: [id])

  @@index([currentDiningGroupId])
  @@map("user_spaces")
}

model DiningGroupMember {
  id            String                     @id @default(uuid()) @db.Uuid
  diningGroupId String                     @map("dining_group_id") @db.Uuid
  userId        String                     @map("user_id") @db.Uuid
  role          DiningGroupRole
  status        LongTermMemberStatus       @default(ACTIVE)
  statusReason  LongTermMemberStatusReason? @map("status_reason")
  joinedAt      DateTime                   @default(now()) @map("joined_at") @db.Timestamptz(3)
  restrictedAt  DateTime?                  @map("restricted_at") @db.Timestamptz(3)
  endedAt       DateTime?                  @map("ended_at") @db.Timestamptz(3)
  version       Int                        @default(1)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([diningGroupId, userId])
  @@index([diningGroupId, status])
  @@index([userId, status])
  @@map("dining_group_members")
}

model DiningGroupInvite {
  id               String                    @id @default(uuid()) @db.Uuid
  diningGroupId    String                    @map("dining_group_id") @db.Uuid
  createdByUserId  String                    @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?                   @map("accepted_by_user_id") @db.Uuid
  tokenHash        String                    @unique @map("token_hash") @db.VarChar(128)
  status           DiningGroupInviteStatus   @default(PENDING)
  expiresAt        DateTime                  @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?                 @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  policyVersion    Int                       @default(1) @map("policy_version")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  diningGroup DiningGroup @relation(fields: [diningGroupId], references: [id])
  createdBy   User        @relation("DiningGroupInviteCreator", fields: [createdByUserId], references: [id])
  acceptedBy  User?       @relation("DiningGroupInviteAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([diningGroupId, status])
  @@index([expiresAt])
  @@map("dining_group_invites")
}

model CarryBackSnapshot {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  sourceDiningGroupId   String                  @map("source_dining_group_id") @db.Uuid
  targetDiningGroupId   String                  @map("target_dining_group_id") @db.Uuid
  sourceDiningGroupName String                  @map("source_dining_group_name") @db.VarChar(80)
  status                CarryBackSnapshotStatus @default(AVAILABLE)
  expiresAt             DateTime                @map("expires_at") @db.Timestamptz(3)
  policyVersion         Int                     @default(1) @map("policy_version")
  recipeCount           Int                     @default(0) @map("recipe_count")
  fridgeItemCount       Int                     @default(0) @map("fridge_item_count")
  shoppingItemCount     Int                     @default(0) @map("shopping_item_count")
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(3)
  invalidatedAt         DateTime?               @map("invalidated_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User        @relation(fields: [userId], references: [id])
  sourceDiningGroup DiningGroup @relation("CarryBackSource", fields: [sourceDiningGroupId], references: [id])
  targetDiningGroup DiningGroup @relation("CarryBackTarget", fields: [targetDiningGroupId], references: [id])

  @@index([userId, status, expiresAt])
  @@index([sourceDiningGroupId])
  @@map("carry_back_snapshots")
}

/// Free 由服务端默认解析；每个用户或饭搭子至多保存一条 Plus 授权。
model EntitlementGrant {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @unique @map("user_id") @db.Uuid
  diningGroupId String?   @unique @map("dining_group_id") @db.Uuid
  startsAt      DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  diningGroup DiningGroup? @relation(fields: [diningGroupId], references: [id], onDelete: Cascade)

  @@map("entitlement_grants")
}

model IdempotencyRecord {
  id            String            @id @default(uuid()) @db.Uuid
  operationId   String            @map("operation_id") @db.Uuid
  operationType String            @map("operation_type") @db.VarChar(64)
  userId        String            @map("user_id") @db.Uuid
  diningGroupId String?           @map("dining_group_id") @db.Uuid
  requestHash   String            @map("request_hash") @db.VarChar(64)
  status        IdempotencyStatus @default(PROCESSING)
  resultJson    Json?             @map("result_json")
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation("IdempotencyRecordUser", fields: [userId], references: [id])
  diningGroup DiningGroup? @relation(fields: [diningGroupId], references: [id])

  @@index([userId, operationType])
  @@index([diningGroupId, operationType])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  action        String         @db.VarChar(64)
  objectType    String         @map("object_type") @db.VarChar(64)
  objectId      String?        @map("object_id") @db.Uuid
  diningGroupId String?        @map("dining_group_id") @db.Uuid
  payload       Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser  User?        @relation("AuditEventActor", fields: [actorUserId], references: [id])
  diningGroup DiningGroup? @relation(fields: [diningGroupId], references: [id])

  @@index([actorType, actorUserId, createdAt])
  @@index([objectType, objectId])
  @@index([diningGroupId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(64)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  nextRunAt     DateTime     @default(now()) @map("next_run_at") @db.Timestamptz(3)
  doneAt        DateTime?    @map("done_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextRunAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
