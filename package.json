{
  "name": "next-meal",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "type-check": "pnpm --filter @next-meal/api type-check && pnpm --filter @next-meal/worker type-check && pnpm --filter @next-meal/client type-check && pnpm --filter @next-meal/admin type-check && pnpm --filter @next-meal/site type-check",
    "dev:api": "pnpm --filter @next-meal/api dev",
    "dev:client": "pnpm --filter @next-meal/client dev:mp-weixin",
    "dev:admin": "pnpm --filter @next-meal/admin dev",
    "dev:site": "pnpm --filter @next-meal/site dev",
    "dev:worker": "pnpm --filter @next-meal/worker dev",
    "build:api": "pnpm --filter @next-meal/api build",
    "build:client": "pnpm --filter @next-meal/client build:mp-weixin",
    "build:admin": "pnpm --filter @next-meal/admin build",
    "build:site": "pnpm --filter @next-meal/site build",
    "build:worker": "pnpm --filter @next-meal/worker build",
    "api:dev": "pnpm dev:api",
    "api:build": "pnpm build:api",
    "client:dev:mp-weixin": "pnpm dev:client",
    "client:build:mp-weixin": "pnpm build:client",
    "start": "bash scripts/local/start-all.sh",
    "restart": "bash scripts/local/restart-all.sh",
    "stop": "bash scripts/local/stop-all.sh",
    "status": "bash scripts/local/status-all.sh",
    "build": "bash scripts/local/build-all.sh",
    "check": "pnpm type-check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  }
}
